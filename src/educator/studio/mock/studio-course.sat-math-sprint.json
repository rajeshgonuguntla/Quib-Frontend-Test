          },
          "content": {
            "kind": "video",
            "duration": "16:05",
            "notes": [
              {
                "at": "02:20",
                "text": "Flip the inequality sign when you multiply or divide by a negative."
              },
              {
                "at": "08:45",
                "text": "Turn \"at least\" into ≥ and \"no more than\" into ≤."
              },
              {
                "at": "13:10",
                "text": "Check the answer against the story: negative tickets are not allowed."
              }
            ]
          },
          "fullTitle": "Inequalities and word problems"
